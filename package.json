{
  "name": "foto-carnet-tauri",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build -- --locked",
    "build:portable": "tauri build --config portable.conf.json -- --locked",
    "check:syntax": "node tests/scripts/check-js-syntax.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "node tests/scripts/check-version.mjs",
    "check:rust": "npm run test:rust && npm run lint:rust",
    "check": "npm run check:syntax && npm run format:check && npm test && npm run check:version && npm run check:rust",
    "test:rust": "cargo test --locked --all-targets --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --locked --all-targets --all-features --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "prettier": "3.9.6",
    "vitest": "4.1.10"
  }
}
